# SQLite database file used by Prisma.
DATABASE_URL="file:./dev.db"

PORT=4000

# Which entry of ../shared/contract-addresses.json to load: "localhost" or "amoy".
CHAIN_NETWORK=localhost

# Overrides the RPC endpoint for the selected network. Defaults to http://127.0.0.1:8545 for
# localhost and the public Amoy RPC for amoy, so this only needs setting for a custom endpoint.
RPC_URL=

# Server-held wallets for the demo. On localhost these default (in src/config.ts) to Hardhat's
# well-known local test keys — the same ones `npx hardhat node` prints on every startup, funded
# only on that ephemeral chain and never holding real value. That lets the backend run against
# localhost with no .env file at all.
#
# REQUIRED when CHAIN_NETWORK=amoy: there is no safe default for a funded network, so the
# backend refuses to start on amoy until these are set to real keys.
REGISTRAR_PRIVATE_KEY=
VERIFIER_PRIVATE_KEY=
ORACLE_PRIVATE_KEY=
# Comma-separated pool of "implementer" (NGO) wallets this backend can sign on behalf of, standing
# in for each project's own wallet for the demo. In production these transactions would be signed
# client-side by the implementing organisation's own wallet; the backend would never hold that key.
IMPLEMENTER_PRIVATE_KEYS=

# Signs session JWTs (see src/utils/jwt.ts). If unset, a random secret is generated at process
# start — fine for a demo where the DB already resets on every boot, but every restart
# invalidates existing sessions. Set this for a stable secret across restarts.
JWT_SECRET=

# mrv-engine's photo-verification API (see ../mrv-engine). Defaults to the local dev port.
MRV_ENGINE_URL=http://127.0.0.1:8088
