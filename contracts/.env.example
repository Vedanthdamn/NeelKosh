# Only needed for the Polygon Amoy testnet deploy. Local demo runs without any of this.
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
DEPLOYER_PRIVATE_KEY=
POLYGONSCAN_API_KEY=

# Optional: assign operational roles to addresses other than the deployer on Amoy.
# Unset, each role defaults to the deployer address.
REGISTRAR_ADDRESS=
VERIFIER_ADDRESS=
ORACLE_ADDRESS=
PLATFORM_TREASURY_ADDRESS=
COMMUNITY_FUND_ADDRESS=

# Optional: override the ERC-1155 metadata URI template for both deploy scripts.
CREDIT_METADATA_URI=
